# API Key de Google AI Studio (gratuita)
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=tu_google_api_key_aqui

# API Key de Pinecone (gratuita con plan Starter)
# https://app.pinecone.io/ → API Keys
PINECONE_API_KEY=tu_pinecone_api_key_aqui

# Nombre del índice en Pinecone (podés elegir el que quieras)
PINECONE_INDEX_NAME=pasteleria-rag
