# Copiá este archivo como .env y completá tus claves
# NUNCA subas el archivo .env a GitHub

# API Key de Pinecone (gratuita con plan Starter)
# https://app.pinecone.io/ → API Keys
PINECONE_API_KEY=tu_pinecone_api_key_aqui

# Nombre del índice en Pinecone (podés elegir el que quieras)
PINECONE_INDEX_NAME=pasteleria-rag

# Nota: los embeddings se generan localmente con HuggingFace (all-mpnet-base-v2)
# No se necesita ninguna API key adicional para los embeddings
